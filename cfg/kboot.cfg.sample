# kboot.cfg -- copy to the boot partition beside the loader and edit.
# Read at most 1024 bytes, comments included.  The README is the reference.

# geom <cyl> <heads> <spt> <precomp>
geom 1024 7 17 512

# The default layout, inherited whole by every entry below.
# part <slot> <start> <blocks>, then swap <slot> <bot> <top>.
part 0 0 136
part 1 10336 13472
part 3 31008 7000
part 4 136 10200
part 15 0 121856
swap 3 2904 7000

# reserve <first> <last> -- segments to keep out of the memory map.
# memtop <seg> -- the highest segment to use; it only ever lowers.

# bflag <NAME> <bit> -- boot-flag names of the kernel below, for the menu.
bflag SINGLE 1

# os <label> <base-block> <kernel-file> [part]
os OpenCoherent-3.5 136 coherent part
# flags <NAME> ... -- this entry boots single user.
flags SINGLE
# console serial|probe -- no line means probe.
console probe

# No `part': no handoff of any kind.
os CPM-8000 58624 cpm.sys

timeout 5
default 1
