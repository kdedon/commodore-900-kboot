#!/bin/sh
# mk/guest/cc2 -- the code generator, run as a guest process.
#
#	cc2 VARIANT IN OUT TEMP [flag]
#
# It writes a COHERENT l.out object directly, so a C source needs no assembly
# step; `as' is only ever called for hand-written .s files.  TEMP is the pass's
# own scratch file and is named by the caller, not invented here.
. "$(dirname "$0")/common.sh"
guest_need
[ $# -ge 4 ] || guest_die "usage: cc2 VARIANT IN OUT TEMP [flag]"
v=$1 in=$2 out=$3
shift 3
guest_run lib/cc2 "$v" "$in" "$(guest_tmp "$out")" "$@" || st=$?
guest_done "$out" "${st:-0}"
